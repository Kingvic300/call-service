# Points at a running call-service instance (npm run start:dev in the parent
# repo, or docker compose up). Tests never talk to a real "backend" — this
# repo doesn't have one; see README.md's "Why no backend registration" note.
CALL_SERVICE_URL=http://localhost:4000
CALL_SERVICE_WS_URL=http://localhost:4000

# Must match one apiKey:secretKey pair in the call-service instance's own
# SERVICE_CREDENTIALS env var. call-service authenticates the *calling
# service* (this test harness stands in for a real integrating backend), not
# individual end users — sockets pass these in `auth.{apiKey,secretKey}`
# alongside a plain userId/displayName it asserts per connection, REST calls
# pass them as X-Api-Key/X-Secret-Key headers. See docs/INTEGRATION.md §2.1.
TEST_API_KEY=change-me-api-key
TEST_SECRET_KEY=change-me-secret-key

# Static port the browser-app bundle is served on during test runs.
BROWSER_APP_PORT=8899
