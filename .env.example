# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=log
CORS_ORIGIN=*

# --- Auth ---
# One (apiKey, secretKey) pair per integrating service — call-service has no
# account relationship with end users of its own, so it authenticates the
# *service* (REST: X-Api-Key/X-Secret-Key headers; sockets: handshake auth)
# and trusts whatever userId/displayName/avatarUrl that service asserts for
# a connection or request, the same trust model Twilio/Daily/Zoom-style
# video platform APIs use. Comma-separated apiKey:secretKey pairs, so a new
# integrating service (or a rotated key) can be added without downtime.
SERVICE_CREDENTIALS=change-me-api-key:change-me-secret-key

# --- API credentials DB (optional) ---
# DB-backed (apiKey, secretKey) pairs for services beyond the ones listed
# above — lets a new integration be added, or an existing one rotated or
# revoked, without redeploying. Without this, only SERVICE_CREDENTIALS
# entries can authenticate. See credentials/credentials.service.ts and
# `npm run seed:credential -- --name <serviceName>`.
# MONGO_URI=mongodb://localhost:27017/call-service

# --- Redis / multi-instance (optional) ---
# Only needed if you run more than one call-service instance behind a load
# balancer. A single instance works fine without any of this. Setting
# REDIS_URL turns on: the Socket.IO Redis adapter (broadcasts reach sockets
# on any instance), the meeting-ownership directory (which instance holds a
# given meeting's mediasoup Router), and REST forwarding for moderation
# calls that land on a non-owning instance. See docs/INTEGRATION.md
# "Multi-instance deployment".
# REDIS_URL=redis://localhost:6379
# When using docker-compose.yml's `redis` service, REDIS_URL must include
# the same password as REDIS_PASSWORD below, e.g.
# redis://:change-me-redis-password@127.0.0.1:6379 — that service binds to
# 127.0.0.1 and requires auth, it is not reachable from other hosts.

# Password for docker-compose.yml's `redis` service (--requirepass). Required
# whenever you run that service (`--profile scaling`) — an unauthenticated
# Redis instance allows any client with network access to read/write the
# meeting-ownership directory and Socket.IO pub/sub, and to achieve RCE via
# CONFIG SET dir + SAVE. Must match the password embedded in REDIS_URL above.
# REDIS_PASSWORD=change-me-redis-password

# Stable identifier for this process, stored as the value in the Redis
# ownership directory. Falls back to `${hostname}-${pid}` if unset — only
# worth setting explicitly if you want a predictable/human-readable id in
# logs (e.g. INSTANCE_ID=call-service-a).
# INSTANCE_ID=

# Base URL OTHER instances use to reach this one (REST forwarding) and that
# clients use to open their Socket.IO connection against the instance that
# actually owns their meeting (returned as `instanceUrl` in POST /meetings
# and POST /calls responses). Falls back to http://127.0.0.1:${PORT}, which
# only works for same-host multi-instance testing — REQUIRED to be a real
# reachable address once REDIS_URL is set and instances run on different
# hosts.
# INSTANCE_INTERNAL_URL=http://127.0.0.1:4000

# --- mediasoup ---
# Defaults to the number of CPU cores if unset. On a 1-vCPU droplet this is 1
# — deliberately fine, see docs/DEPLOYMENT.md.
# MEDIASOUP_NUM_WORKERS=1
MEDIASOUP_LOG_LEVEL=warn
MEDIASOUP_LISTEN_IP=0.0.0.0
# Public IP clients should send/receive media on — REQUIRED in production.
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
# Every worker shares ONE UDP+TCP port for all its WebRTC transports (worker N
# listens on this port + N) — open [PORT, PORT + MEDIASOUP_NUM_WORKERS - 1].
MEDIASOUP_WEBRTC_PORT=44000
MEDIASOUP_INITIAL_AVAILABLE_OUTGOING_BITRATE=800000
MEDIASOUP_MAX_INCOMING_BITRATE=1500000

# --- coturn ---
TURN_HOST=127.0.0.1
TURN_PORT=3478
TURN_TLS_PORT=5349
# Must match coturn's static-auth-secret in docker/coturn/turnserver.conf
TURN_SECRET=change-me-turn-shared-secret
TURN_CREDENTIAL_TTL_SECONDS=86400

# --- Feature tuning ---
CHAT_HISTORY_LIMIT=200
WS_RATE_LIMIT_POINTS=30
WS_RATE_LIMIT_DURATION_MS=1000
CONNECTION_RATE_LIMIT_PER_MINUTE=60
DISCONNECT_GRACE_PERIOD_MS=10000
